# ==============================================================================
# TransitERA WebGIS - Environment Configuration Template
# Salin file ini menjadi `.env` di dalam folder `webdev/`:
#   cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# ==============================================================================

# --- MAPID Configuration ---
NEXT_PUBLIC_MAPID_API_KEY=your_mapid_api_key_here
MAPID_API_KEY=your_mapid_api_key_here

# --- AI Configuration (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database Configuration (PostgreSQL / PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transitera
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transitera

# --- Backend Configuration ---
BACKEND_PORT=8000
ENVIRONMENT=development

# --- Frontend Configuration ---
FRONTEND_PORT=3030
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api
